SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local: http://127.0.0.1:8888/callback   Deployed: https://<your-app-domain>/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Required when deployed (https redirect URI). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# Optional: where the per-user SQLite database lives (use a persistent disk when deployed)
# TUNETWIN_DB_PATH=instance/tunetwin.db
# Optional locally, recommended when deployed: PostgreSQL (e.g. Neon) connection URL.
# When set, accounts and learning are stored there and survive restarts.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
